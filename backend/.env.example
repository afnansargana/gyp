PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/autofixhub
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
FRONTEND_URL=http://localhost:3001
CLIENT_URL=http://localhost:3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OTP / email (optional in development — OTP is logged + returned in API)
OTP_EXPIRY_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AutoFixHub <noreply@autofixhub.local>"
GEMINI_API_KEY=
